  "components": {
    "schemas": {
      "AddressDto": {
        "required": [
          "contactName",
          "phone",
          "line1",
          "city",
          "postalCode",
          "countryCode"
        ],
        "type": "object",
        "properties": {
          "contactName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": [
              "null",
              "string"
            ]
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": [
              "null",
              "string"
            ]
          },
          "postalCode": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "CreateOrderItemDto": {
        "required": [
          "sku",
          "name",
          "quantity",
          "unitPrice"
        ],
        "type": "object",
        "properties": {
          "sku": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "quantity": {
            "maximum": 10000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "unitPrice": {
            "maximum": 1000000,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "CreateOrderRequest": {
        "required": [
          "pickupAddress",
          "deliveryAddress",
          "currencyCode",
          "weightKg",
          "declaredValue",
          "items"
        ],
        "type": "object",
        "properties": {
          "pickupAddress": {
            "$ref": "#/components/schemas/AddressDto"
          },
          "deliveryAddress": {
            "$ref": "#/components/schemas/AddressDto"
          },
          "currencyCode": {
            "maxLength": 3,
            "minLength": 3,
            "pattern": "^[A-Z]{3}",
            "type": "string"
          },
          "weightKg": {
            "maximum": 2000,
            "minimum": 0.1,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "declaredValue": {
            "maximum": 10000000,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "note": {
            "maxLength": 500,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderItemDto"
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "OutboxRetryBatchRequest": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "max": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      }
    }
  },
